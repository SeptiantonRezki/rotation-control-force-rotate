<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_ethereal_gradient">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/controlPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/controlContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="22dp">

                <TextView
                    android:id="@+id/serviceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:minHeight="58dp"
                    android:padding="15dp"
                    android:text="Service active"
                    android:textColor="@color/ethereal_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/serviceSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="Rotation service"
                    android:textColor="@color/ethereal_text_primary"
                    app:thumbTint="@color/ethereal_lavender"
                    app:trackTint="@color/ethereal_control_track" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:layout_marginBottom="7dp"
                    android:text="Choose rotation"
                    android:textColor="@color/ethereal_text_primary"
                    android:textSize="19sp"
                    android:fontFamily="sans-serif-medium" />

                <GridLayout
                    android:id="@+id/modeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3" />

                <FrameLayout
                    android:id="@+id/controlNativeAd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" />

                <FrameLayout
                    android:id="@+id/bannerSlotControl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <FrameLayout
                        android:id="@+id/bannerContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center"
                        android:padding="6dp" />
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/appsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/appsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Search apps..."
                    app:boxBackgroundColor="@color/ethereal_glass_fill"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/ethereal_lavender"
                    app:hintTextColor="@color/ethereal_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/searchApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/ethereal_text_primary"
                        android:textColorHint="@color/ethereal_text_secondary" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/appLoadingState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:visibility="gone">

                    <ProgressBar
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminateTint="@color/ethereal_mint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Loading apps…"
                        android:textColor="@color/ethereal_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/appEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:padding="18dp"
                    android:text="No matching apps"
                    android:textColor="@color/ethereal_text_secondary"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appList"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:layout_marginTop="9dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="never" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:text="Enable Per-App Rotation in Accessibility settings to apply your profiles as apps open."
                    android:textColor="@color/ethereal_text_secondary"
                    android:textSize="13sp" />

                <FrameLayout
                    android:id="@+id/appsNativeAd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" />

                <FrameLayout
                    android:id="@+id/bannerSlotApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/permissionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"
                        android:text="Permission status"
                        android:textColor="@color/ethereal_text_primary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/grantSettingsButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Grant system rotation access"
                        android:textColor="@color/ethereal_button_text"
                        app:backgroundTint="@color/ethereal_lavender"
                        app:cornerRadius="18dp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoStartSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:text="Auto-start and restore after reboot"
                    android:textColor="@color/ethereal_text_primary"
                    app:thumbTint="@color/ethereal_mint"
                    app:trackTint="@color/ethereal_control_track" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/callBypassSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:text="Pause rotation during phone calls"
                    android:textColor="@color/ethereal_text_primary"
                    app:thumbTint="@color/ethereal_mint"
                    app:trackTint="@color/ethereal_control_track" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accessibilityButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Configure Per-App Profiles"
                    android:textColor="@color/ethereal_button_text"
                    app:backgroundTint="@color/ethereal_mint"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacyOptionsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Privacy options"
                    android:textColor="@color/ethereal_text_primary"
                    android:visibility="gone"
                    app:backgroundTint="@color/ethereal_glass_fill"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/privacyPolicyButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Privacy Policy"
                    android:textColor="@color/ethereal_text_primary"
                    app:backgroundTint="@color/ethereal_glass_fill"
                    app:cornerRadius="18dp" />

                <FrameLayout
                    android:id="@+id/settingsNativeAd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" />

                <FrameLayout
                    android:id="@+id/bannerSlotSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:text="Rotation Control: Force Rotate · Version 1.0.0\nRotation behavior depends on Android and device manufacturer policies."
                    android:textColor="@color/ethereal_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/bg_bottom_glass"
        android:elevation="10dp"
        app:itemIconTint="@color/ethereal_navigation_tint"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconSize="19dp"
        app:itemPaddingTop="0dp"
        app:itemPaddingBottom="0dp"
        app:itemRippleColor="@color/ethereal_ripple"
        app:itemTextColor="@color/ethereal_navigation_tint"
        app:itemHorizontalTranslationEnabled="false"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
