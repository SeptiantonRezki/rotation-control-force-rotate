<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:minHeight="82dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_app_icon"
        android:contentDescription="App icon"
        android:padding="4dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ethereal_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/packageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ethereal_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/profileInput"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:hint="Rotation"
        app:boxBackgroundColor="@color/ethereal_dropdown_fill"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/ethereal_dropdown_stroke"
        app:endIconTint="@color/ethereal_lavender"
        app:hintTextColor="@color/ethereal_text_secondary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/profileDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:inputType="none"
            android:maxLines="1"
            android:minHeight="52dp"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:textColor="@color/ethereal_text_primary"
            android:textSize="12sp"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
